# Optional live GitHub App read-only discovery. Do not commit a real .env file.
DAVDEPLOY_GITHUB_APP_READ_ONLY=false
DAVDEPLOY_GITHUB_APP_ID=
DAVDEPLOY_GITHUB_APP_INSTALLATION_ID=
DAVDEPLOY_GITHUB_APP_KEY_HOST_PATH=

# AWS Quick Create and server-side role verification. Keep values out of Git.
DAVDEPLOY_CONTROL_PLANE_ROLE_ARN=
DAVDEPLOY_DISCOVERY_BROKER_ROLE_ARN=
DAVDEPLOY_EXECUTION_BROKER_ROLE_ARN=
DAVDEPLOY_NOVA_PLAN_BROKER_ROLE_ARN=
DAVDEPLOY_AWS_CONNECTION_TEMPLATE_URL=
DAVDEPLOY_AWS_LIVE_DISCOVERY_ENABLED=false

# Connection ExternalIds are stored server-side and passed in Quick Create URLs to
# configure customer trust. Treat those URLs as sensitive. Use aws_secrets_manager in
# a deployed control plane; local_encrypted is a local-only deterministic substitute.
DAVDEPLOY_CONNECTION_SECRET_BACKEND=local_encrypted
DAVDEPLOY_CONNECTION_SECRET_KEY=
DAVDEPLOY_CONNECTION_SECRET_PREFIX=davdeploy/customer-connections

# External-provider activation (all safe defaults; no external call is made until
# a later adapter is explicitly enabled). Use Google Workspace for your team and
# Cognito for customer identities when accounts are ready.
DAVDEPLOY_IDENTITY_PROVIDER=local
DAVDEPLOY_GOOGLE_WORKSPACE_DOMAIN=
DAVDEPLOY_OIDC_ISSUER=
DAVDEPLOY_OIDC_AUDIENCE=
DAVDEPLOY_JWKS_URL=
DAVDEPLOY_COGNITO_USER_POOL_ID=
DAVDEPLOY_COGNITO_APP_CLIENT_ID=

# Keep email disabled until a verified sending domain and provider account exist.
DAVDEPLOY_EMAIL_PROVIDER=disabled
DAVDEPLOY_GMAIL_SENDER=
DAVDEPLOY_SES_REGION=

# Keep billing manual during the invite-only beta; Stripe keys belong in the
# deployer's secret manager, never this file or Git.
DAVDEPLOY_BILLING_PROVIDER=manual
DAVDEPLOY_STRIPE_WEBHOOK_SECRET=
DAVDEPLOY_ANALYTICS_PROVIDER=local

# Exact browser origins allowed to call the API. Use comma-separated HTTPS
# origins in hosted environments. Wildcards, paths and public HTTP origins fail
# closed. Localhost HTTP is accepted only for development.
DAVDEPLOY_ALLOWED_FRONTEND_ORIGINS=http://localhost:5173

# Amazon Nova 2 Lite through Bedrock. The fixture remains the safe local default.
# Enabling Bedrock uses the normal AWS SDK role/credential chain; never add access
# keys to this file. `us.` keeps inference within the US geography.
DAVDEPLOY_MODEL_PROVIDER=fixture
DAVDEPLOY_MODEL_FALLBACK=disabled
DAVDEPLOY_BEDROCK_REGION=us-east-1
DAVDEPLOY_BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
DAVDEPLOY_MODEL_DATA_POLICY=bedrock-no-training
DAVDEPLOY_MODEL_MAX_OUTPUT_TOKENS=2000
DAVDEPLOY_MODEL_TIMEOUT_SECONDS=60
DAVDEPLOY_MODEL_CONNECT_TIMEOUT_SECONDS=5
DAVDEPLOY_MODEL_MAX_ATTEMPTS=2

# Optional audited pricing inputs. Set both rates and a catalog version together
# from the current Bedrock pricing page; unset values produce no cost claim.
DAVDEPLOY_NOVA_INPUT_PRICE_PER_MILLION_USD=
DAVDEPLOY_NOVA_OUTPUT_PRICE_PER_MILLION_USD=
DAVDEPLOY_NOVA_PRICING_CATALOG_VERSION=
